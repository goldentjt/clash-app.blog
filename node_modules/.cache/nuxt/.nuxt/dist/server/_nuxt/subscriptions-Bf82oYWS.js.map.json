{"file":"subscriptions-Bf82oYWS.js","mappings":";;;;;;;;;;;;EAmEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,gBAAgB;EAE5D,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GAjHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA4DgB,GAAA,OAAA,SAAA,aAAA;;;;OAjCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,mBAAkB,GAAA;OAAjC,SAAAG,SAEU,GAAA,OAAA,SAAA,aAAA;;a,QADRC,YAAmG,KAAA,MAAhG,8FAA4F,C;;;;;;OAU/F,OAAM;OACL,OAAO;;;;MArDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAmC,UAAA,MAA3B,oBAAkB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WAC7K;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,aAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,oJAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,WAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,8LAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,cAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,iIAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,mBAAkB,GAAA;QAC/B,SAAAD,cAAmG,CAAnGC,YAAmG,KAAA,MAAhG,8FAA4F,C;;;;MAKnGA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/subscriptions.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash订阅管理：跨设备添加与刷新</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 确认订阅授权\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        订阅链接（Subscription URL）是连接客户端与机场节点服务器的通信纽带。一个标准的 Clash 订阅链接由机场服务商动态生成，内置了鉴权密钥（Token）。客户端向该链接发起 HTTP GET 请求时，服务端会实时返回当前所有可用节点的状态、IP、端口以及预设的分流规则列表。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 分别导入\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        跨设备使用订阅时，需注意不同平台的添加机制：Windows/macOS 桌面端支持直接粘贴 URL 并设置「自动更新间隔」（推荐设置为 24 小时或 12 小时一次）；Android 手机端可在 Clash Meta for Android 中新建配置输入 URL；iOS 端则可在 Shadowrocket 或 Stash 中选择「类型: Subscribe」一键拉取。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"跨设备订阅同步与防阻断刷新时序图\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"订阅请求通过安全通道获取最新节点池\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 更新和失效处理\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        当遇到订阅刷新失败（如提示 Socket Timeout 或 Status 500）时，先确认本地是否有可用的前置网络代理。若当前节点全部失效导致无法访问机场订阅域名，可尝试切换手机热点，或者登录机场后台临时开启「应急备用订阅通道」重新拉取节点列表。\n      </p>\n\n      <TipNote title=\"为什么有时不翻墙就无法更新订阅？\">\n        <p>部分机场的订阅分发服务器部署在海外且未被国内直接加速，当你的电脑完全断网或节点全失效时，就无法连接海外订阅服务器。建议在手机上保留一个稳定的轻量备用节点（或手机热点）用来拉取初始订阅。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash订阅管理：跨设备添加与刷新 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/subscriptions')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"复制机场唯一专属订阅链接\",\n    \"desc\": \"在机场控制台（如 U1S1、极连云、光年梯）复制专属 Clash 订阅链接，严防在公共群组公开展示。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"按设备平台粘贴并设置自动更新\",\n    \"desc\": \"在各设备客户端填入链接，设置更新周期（建议 1440 分钟/每天），确保节点变动自动同步。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"处理订阅刷新异常与域名更换\",\n    \"desc\": \"若机场因防封更换了订阅分发域名，及时在客户端编辑原配置中的 URL 地址即可恢复拉取。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"妥善保管个人专属订阅 URL，未在公共网页或论坛暴露包含 Token 的参数\",\n    \"tip\": \"Token 泄露可能导致他人盗刷你的流量\"\n  },\n  {\n    \"text\": \"在客户端中开启了「自动更新订阅」功能\",\n    \"tip\": \"确保敏感时期能够自动获取抗封锁的新节点\"\n  },\n  {\n    \"text\": \"确认订阅套餐尚未到期且月度流量有剩余额度\",\n    \"tip\": \"流量耗尽会导致订阅拉取失败或节点无响应\"\n  },\n  {\n    \"text\": \"测试多设备并发使用未超出机场设定的最大连接数限制\",\n    \"tip\": \"多设备推荐选 浪网 或 FlyV 不限设备方案\"\n  }\n]\n</script>\n"],"version":3}