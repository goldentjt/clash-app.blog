,YAAqB,QAAA,MAAf,UAAQ,GACdA,YAAc,QAAA,MAAR,GAAC,C;;;;;;IAcO,IAAG;IAAY,OAAM;;IAA/B,SAAAD,SAAoF,GAAA,OAAA,SAAA,aAAA;;U,QAA9BE,gBAAA,qBAAmB,C;;;;;;IAC/D,IAAG;IAAgB,OAAM;;IAAnC,SAAAF,SAAuF,GAAA,OAAA,SAAA,aAAA;;U,QAA7BE,gBAAA,oBAAkB,C;;;;;;IAClE,IAAG;IAAc,OAAM;;IAAjC,SAAAF,SAAoF,GAAA,OAAA,SAAA,aAAA;;U,QAA5BE,gBAAA,mBAAiB,C;;;;;;IAIrE,IAAG;IAAc,OAAM;;IAAjC,SAAAF,SAGW,GAAA,OAAA,SAAA,aAAA;;U,QAFTC,YAAqB,QAAA,MAAf,UAAQ,GACdA,YAAc,QAAA,MAAR,GAAC,C;;;;;;GA+BR,MAAA,6RAAAE,cAAA,OAAAC,+BAAe,EAAA,+wBAAA;;IAWR,IAAG;IAAS,OAAM;;IAA5B,SAAAJ,SAAiG,GAAA,OAAA,SAAA,aAAA;;U,QAA1BE,gBAAA,iBAAe,C;;;;;IAC5E,IAAG;IAAiB,OAAM;;IAApC,SAAAF,SAA4E,GAAA,OAAA,SAAA,aAAA;;U,QAAtBE,gBAAA,aAAW,C;;;;;IACvD,IAAG;IAAiB,OAAM;;IAApC,SAAAF,SAAwE,GAAA,OAAA,SAAA,aAAA;;U,QAAlBE,gBAAA,SAAO,C","names":["_ssrRenderAttrs","_mergeProps","_withCtx","_createVNode","_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_withCtx","_ssrInterpolate","_createVNode","_toDisplayString","_openBlock","_createBlock","_ssrRenderAttrs","_mergeProps","_withCtx","_createVNode","_ssrInterpolate","_createTextVNode","_toDisplayString","_ssrRenderAttr","_ssrRenderAttrs","_mergeProps","_ssrRenderClass","_unref","_ssrInterpolate","_ssrRenderComponent","_withCtx","_createVNode","_createTextVNode","_ssrRenderAttr","_imports_0"],"sources":["../../../../../../../components/HeroBanner.vue","../../../../../../../components/CoverCard.vue","../../../../../../../components/ToolCategoryCard.vue","../../../../../../../components/TopAirportsHero.vue","../../../../../../../components/ReadingModeToggle.vue","../../../../../../../pages/index.vue"],"sourcesContent":["<template>\n  <div class=\"relative overflow-hidden bg-gradient-to-b from-[#FFFCF5] to-[#F9F5EC] border-b border-[#E4D8C7] py-12 sm:py-16\">\n    <!-- Decorative subtle warm background blur circles -->\n    <div class=\"absolute top-0 right-1/4 w-96 h-96 bg-[#B08758]/10 rounded-full blur-3xl pointer-events-none\"></div>\n    <div class=\"absolute bottom-0 left-10 w-72 h-72 bg-[#79553D]/5 rounded-full blur-2xl pointer-events-none\"></div>\n\n    <!-- 持续循环环境动效 2: 首屏边缘极简叶片线稿 (11秒周期轻摆，角度不超过3度，手机端保留并缩小幅度) -->\n    <div class=\"leaf-sway-11 absolute top-4 left-2 sm:top-6 sm:left-8 z-10 pointer-events-none select-none opacity-25 text-[#79553D]\" aria-hidden=\"true\">\n      <svg class=\"w-7 h-9 sm:w-9 sm:h-13\" width=\"38\" height=\"52\" viewBox=\"0 0 38 52\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M19 50C19 36 19 15 19 2\"/>\n        <path d=\"M19 40C13 38 7 31 9 23C11 23 16 27 19 32\"/>\n        <path d=\"M19 28C25 26 31 19 29 11C27 11 22 15 19 20\"/>\n        <path d=\"M19 16C15 14 11 8 13 3C14 3 17 6 19 10\"/>\n      </svg>\n    </div>\n\n    <!-- 持续循环环境动效 2: 首屏边缘极简叶片线稿 (15秒周期轻摆，右侧叶片在手机端隐藏，保持小屏清爽) -->\n    <div class=\"leaf-sway-15 hidden sm:block absolute top-12 right-3 sm:right-10 z-10 pointer-events-none select-none opacity-25 text-[#B08758]\" aria-hidden=\"true\">\n      <svg width=\"34\" height=\"46\" viewBox=\"0 0 34 46\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <path d=\"M17 44C17 30 17 13 17 2\"/>\n        <path d=\"M17 34C23 32 28 26 26 19C24 19 19 23 17 27\"/>\n        <path d=\"M17 24C11 22 6 16 8 9C10 9 15 12 17 17\"/>\n        <path d=\"M17 14C21 12 24 7 22 3C21 3 18 5 17 9\"/>\n      </svg>\n    </div>\n\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n      <div class=\"max-w-4xl mx-auto text-center space-y-6\">\n        <!-- Badge -->\n        <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFFCF5] border border-[#E4D8C7] text-xs font-medium text-[#79553D] shadow-sm\">\n          <span class=\"w-2 h-2 rounded-full bg-[#B08758] animate-pulse\"></span>\n          <span>奶油咖啡·图解课堂 ｜ 2026 全平台 Clash 实践知识库</span>\n        </div>\n\n        <!-- 持续循环环境动效 1: 标题两侧咖啡色装饰括号缓慢开合 (向外移动3px回到原位，8秒一轮，文字与占位始终固定，独立图层) -->\n        <h1 class=\"text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight sm:leading-snug select-text\">\n          <span class=\"bracket-anim-left text-[#B08758] font-serif mr-1 select-none pointer-events-none\" aria-hidden=\"true\">【</span>\n          <span class=\"phrase-color-transition font-bold\">按平台选择Clash应用</span>\n          <span class=\"text-[#79553D]\">并学会维护</span>\n          <span class=\"bracket-anim-right text-[#B08758] font-serif ml-1 select-none pointer-events-none\" aria-hidden=\"true\">】</span>\n        </h1>\n\n        <!-- High-CTR & Long-tail Subtitle Description -->\n        <p class=\"text-base sm:text-lg text-[#79553D] max-w-2xl mx-auto leading-relaxed\">\n          解决 <strong class=\"text-[#493A30]\">Clash下载</strong>、<strong class=\"text-[#493A30]\">Clash配置导入</strong>、<strong class=\"text-[#493A30]\">Clash订阅刷新</strong> 与 <strong class=\"text-[#493A30]\">Clash无法连接</strong> 全生命周期问题。支持 Windows、Mac (M系列芯片)、Android、iOS 与 Linux，一步一图，真实可验。\n        </p>\n\n        <!-- Call to Action Buttons -->\n        <div class=\"flex flex-wrap items-center justify-center gap-3 pt-2\">\n          <NuxtLink\n            to=\"/download\"\n            class=\"px-6 py-3 rounded-custom bg-[#79553D] text-[#FFFCF5] font-bold text-sm sm:text-base hover:bg-[#5C3E2A] transition-all shadow-warm hover:shadow-warm-hover flex items-center gap-2 group\"\n          >\n            <span>📥 下载 Clash 适配安装包</span>\n            <span class=\"group-hover:translate-x-1 transition-transform\">→</span>\n          </NuxtLink>\n          <NuxtLink\n            to=\"/airport-recommend\"\n            class=\"px-6 py-3 rounded-custom bg-[#FFFCF5] text-[#79553D] font-bold text-sm sm:text-base border-2 border-[#B08758] hover:bg-[#F2EAE1] transition-all shadow-sm flex items-center gap-2\"\n          >\n            <span>⚡️ 查看 4 大主力机场推荐</span>\n            <span class=\"text-xs bg-[#B08758] text-white px-2 py-0.5 rounded-full font-normal\">低延迟</span>\n          </NuxtLink>\n        </div>\n\n        <!-- Platform Quick Selector Icons Bar -->\n        <div class=\"pt-8 grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-3 max-w-3xl mx-auto text-xs\">\n          <NuxtLink to=\"/windows\" class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-sm transition-all flex flex-col items-center gap-1 group\">\n            <span class=\"text-lg\">🪟</span>\n            <span class=\"font-bold text-[#493A30] group-hover:text-[#79553D]\">Windows</span>\n            <span class=\"text-[10px] text-[#79553D]/80\">Win10/11 x64/arm64</span>\n          </NuxtLink>\n          <NuxtLink to=\"/mac\" class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-sm transition-all flex flex-col items-center gap-1 group\">\n            <span class=\"text-lg\">🍎</span>\n            <span class=\"font-bold text-[#493A30] group-hover:text-[#79553D]\">macOS</span>\n            <span class=\"text-[10px] text-[#79553D]/80\">Apple M/Intel</span>\n          </NuxtLink>\n          <NuxtLink to=\"/android\" class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-sm transition-all flex flex-col items-center gap-1 group\">\n            <span class=\"text-lg\">🤖</span>\n            <span class=\"font-bold text-[#493A30] group-hover:text-[#79553D]\">Android</span>\n            <span class=\"text-[10px] text-[#79553D]/80\">APK后台保活</span>\n          </NuxtLink>\n          <NuxtLink to=\"/iphone\" class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-sm transition-all flex flex-col items-center gap-1 group\">\n            <span class=\"text-lg\">📱</span>\n            <span class=\"font-bold text-[#493A30] group-hover:text-[#79553D]\">iOS / iPad</span>\n            <span class=\"text-[10px] text-[#79553D]/80\">Shadowrocket/Stash</span>\n          </NuxtLink>\n          <NuxtLink to=\"/linux\" class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-sm transition-all flex flex-col items-center gap-1 group col-span-2 sm:col-span-1\">\n            <span class=\"text-lg\">🐧</span>\n            <span class=\"font-bold text-[#493A30] group-hover:text-[#79553D]\">Linux</span>\n            <span class=\"text-[10px] text-[#79553D]/80\">AppImage/Systemd</span>\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n","<template>\n  <div class=\"cover-card-container group relative rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] shadow-sm hover:shadow-warm transition-all duration-300 flex flex-col\">\n    <!-- 持续循环环境动效 3: 重点教程封面回形针轻微摆动 (顶部为轴，10秒一轮，左右约2度，分离于点击区) -->\n    <div class=\"paperclip-decor absolute -top-2.5 right-6 z-25 pointer-events-none select-none\" aria-hidden=\"true\">\n      <svg width=\"18\" height=\"34\" viewBox=\"0 0 18 34\" fill=\"none\" class=\"text-[#B08758] drop-shadow-2xs\">\n        <path d=\"M5 9V24C5 27.3137 7.68629 30 11 30C14.3137 30 17 27.3137 17 24V6C17 3.23858 14.7614 1 12 1C9.23858 1 7 3.23858 7 6V23C7 24.6569 8.34315 26 10 26C11.6569 26 13 24.6569 13 23V8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n\n    <!-- Visual Image / Thumbnail Area -->\n    <div class=\"relative w-full aspect-video bg-[#F2EAE1] overflow-hidden rounded-t-custom flex items-center justify-center border-b border-[#E4D8C7]\">\n      <!-- SVG Simulated Illustration -->\n      <div class=\"w-full h-full p-4 flex flex-col justify-between relative\">\n        <div class=\"flex items-center justify-between z-10\">\n          <span class=\"text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#FFFCF5]/90 text-[#79553D] border border-[#E4D8C7]\">\n            {{ badge || '图解步骤' }}\n          </span>\n          <span class=\"text-xs font-semibold text-[#B08758]\">⏱ {{ readTime }}</span>\n        </div>\n        <div class=\"flex items-center justify-center my-auto\">\n          <div class=\"w-12 h-12 rounded-full bg-[#FFFCF5] border-2 border-[#B08758] flex items-center justify-center text-xl shadow-sm group-hover:scale-110 transition-transform\">\n            {{ icon || '📖' }}\n          </div>\n        </div>\n        <div class=\"text-[11px] font-mono text-[#79553D]/70 z-10 flex justify-between\">\n          <span>{{ category }}</span>\n          <span>clash-app.blog</span>\n        </div>\n      </div>\n\n      <!-- Animation 4: 封面说明条展开 (悬停或聚焦时向上滑出展开真实摘要，手机端直接可见) -->\n      <div class=\"cover-summary-bar absolute inset-x-0 bottom-0 bg-[#493A30]/95 text-[#FFFCF5] p-3 text-xs leading-relaxed backdrop-blur-sm z-20\">\n        <div class=\"flex items-center justify-between mb-1 text-[10px] text-[#B08758]\">\n          <span class=\"font-bold\">核心提要</span>\n          <span>点击进入正文 →</span>\n        </div>\n        <p class=\"line-clamp-3 text-[11px] text-[#F9F5EC]\">{{ summary }}</p>\n      </div>\n    </div>\n\n    <!-- Card Base Content -->\n    <div class=\"p-4 flex-1 flex flex-col justify-between\">\n      <div>\n        <h3 class=\"text-base font-bold text-[#493A30] group-hover:text-[#79553D] transition-colors leading-snug mb-1\">\n          {{ title }}\n        </h3>\n        <!-- Mobile explicit summary visible directly -->\n        <p class=\"md:hidden text-xs text-[#79553D] line-clamp-2 mt-1 mb-2\">\n          {{ summary }}\n        </p>\n      </div>\n\n      <div class=\"pt-3 border-t border-[#E4D8C7]/50 flex items-center justify-between text-xs text-[#79553D]\">\n        <span>查看完整图解</span>\n        <span class=\"group-hover:translate-x-1 transition-transform font-bold text-[#79553D]\">→</span>\n      </div>\n    </div>\n\n    <!-- Clickable overlay NuxtLink -->\n    <NuxtLink :to=\"link\" class=\"absolute inset-0 z-30\" :aria-label=\"title\"></NuxtLink>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\ndefineProps<{\n  title: string\n  summary: string\n  link: string\n  category: string\n  readTime: string\n  icon?: string\n  badge?: string\n}>()\n</script>\n","<template>\n  <NuxtLink\n    :to=\"link\"\n    class=\"tool-category-card group p-5 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] hover:border-[#79553D] hover:shadow-warm transition-all flex flex-col justify-between\"\n  >\n    <div class=\"flex items-start gap-3\">\n      <!-- Animation 5: 工具图标摇摆 (tool-icon swings ±3deg on hover/focus) -->\n      <div class=\"tool-icon w-12 h-12 rounded-custom bg-[#F9F5EC] border border-[#E4D8C7] group-hover:border-[#B08758] flex items-center justify-center text-2xl shrink-0 transition-transform\">\n        <span>{{ icon }}</span>\n      </div>\n\n      <div class=\"space-y-1\">\n        <div class=\"flex items-center gap-2\">\n          <h3 class=\"font-bold text-sm text-[#493A30] group-hover:text-[#79553D] transition-colors\">\n            {{ title }}\n          </h3>\n          <span v-if=\"tag\" class=\"text-[10px] px-1.5 py-0.2 rounded bg-[#EBDCCB] text-[#79553D] font-medium\">\n            {{ tag }}\n          </span>\n        </div>\n        <p class=\"text-xs text-[#79553D] leading-relaxed line-clamp-2\">\n          {{ desc }}\n        </p>\n      </div>\n    </div>\n\n    <div class=\"mt-4 pt-3 border-t border-[#E4D8C7]/50 flex items-center justify-between text-xs text-[#79553D]\">\n      <span>{{ count }} 篇核心教程</span>\n      <span class=\"group-hover:translate-x-1 transition-transform font-bold text-[#79553D]\">浏览 →</span>\n    </div>\n  </NuxtLink>\n</template>\n\n<script setup lang=\"ts\">\ndefineProps<{\n  title: string\n  desc: string\n  link: string\n  icon: string\n  count: number\n  tag?: string\n}>()\n</script>\n","<template>\n  <div class=\"my-8 rounded-custom bg-[#FFFCF5] border-2 border-[#B08758] p-5 sm:p-6 shadow-warm relative overflow-hidden\">\n    <!-- Header banner -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[#E4D8C7] pb-4 mb-5\">\n      <div>\n        <div class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#EBDCCB] text-[#79553D] text-[11px] font-bold mb-1\">\n          <span>👑 核心节点服务精选</span>\n          <span>·</span>\n          <span>4大主力机场定位区分</span>\n        </div>\n        <h2 class=\"text-xl sm:text-2xl font-extrabold text-[#493A30] tracking-tight\">\n          四大主力机场定位差异与直达推荐\n        </h2>\n        <p class=\"text-xs text-[#79553D] mt-0.5\">\n          按网络需求匹配，避免盲目选型；官网直达注册均配置独家优惠码。\n        </p>\n      </div>\n\n      <NuxtLink\n        to=\"/airport-recommend\"\n        class=\"text-xs font-bold text-[#79553D] hover:text-[#493A30] bg-[#F9F5EC] hover:bg-[#F4ECE1] px-3 py-1.5 rounded-custom border border-[#E4D8C7] shrink-0 transition-colors flex items-center gap-1\"\n      >\n        <span>查看 28 家完整横评与避坑指南</span>\n        <span>→</span>\n      </NuxtLink>\n    </div>\n\n    <!-- 4 Major Airports Grid -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5\">\n      <div\n        v-for=\"item in topAirports\"\n        :key=\"item.id\"\n        class=\"rounded-custom bg-[#F9F5EC] border border-[#E4D8C7] hover:border-[#79553D] p-3.5 flex flex-col justify-between shadow-xs transition-all hover:shadow-sm\"\n      >\n        <div class=\"space-y-2\">\n          <!-- Top Badge & Number -->\n          <div class=\"flex items-center justify-between\">\n            <span class=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#79553D] text-white\">\n              0{{ item.num }} 主力\n            </span>\n            <span class=\"text-[10px] font-bold text-[#B08758]\">\n              {{ item.tag }}\n            </span>\n          </div>\n\n          <!-- Name & Core Positioning -->\n          <div>\n            <h3 class=\"text-base font-extrabold text-[#493A30]\">\n              <NuxtLink :to=\"`/airport/${item.id}`\" class=\"hover:underline\">\n                {{ item.name }}\n              </NuxtLink>\n            </h3>\n            <p class=\"text-[11px] font-semibold text-[#79553D] mt-0.5\">\n              {{ item.positioning }}\n            </p>\n          </div>\n\n          <!-- Price & Promo -->\n          <div class=\"p-1.5 rounded bg-[#FFFCF5] border border-[#E4D8C7] text-[11px] space-y-0.5\">\n            <div class=\"flex justify-between items-center\">\n              <span class=\"text-[#79553D]\">起步门槛：</span>\n              <span class=\"font-mono font-bold text-[#79553D]\">{{ item.minPrice }}</span>\n            </div>\n            <div class=\"flex justify-between items-center text-[10px]\">\n              <span class=\"text-[#79553D]\">优惠码：</span>\n              <span class=\"font-mono font-bold text-[#493A30] bg-[#EBDCCB] px-1 rounded\">{{ item.promoCode }}</span>\n            </div>\n          </div>\n\n          <!-- Distinct Advantage Analysis -->\n          <p class=\"text-[11px] text-[#493A30] leading-snug line-clamp-2\">\n            {{ item.sellingPoints }}\n          </p>\n        </div>\n\n        <!-- Prominent Registration Button with rel=\"sponsored nofollow noopener\" -->\n        <div class=\"pt-2.5 mt-2 border-t border-[#E4D8C7] space-y-1\">\n          <a\n            :href=\"item.inviteUrl\"\n            target=\"_blank\"\n            rel=\"sponsored nofollow noopener\"\n            class=\"w-full py-1.5 px-2 rounded-custom bg-[#79553D] hover:bg-[#5C3E2A] text-white font-bold text-[11px] flex items-center justify-center gap-1 shadow-xs transition-colors\"\n          >\n            <span>⚡️ 直达注册 {{ item.name }}</span>\n            <span>→</span>\n          </a>\n          <NuxtLink\n            :to=\"`/airport/${item.id}`\"\n            class=\"block text-center text-[10px] text-[#79553D] hover:underline\"\n          >\n            查阅独立评测 →\n          </NuxtLink>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { AIRPORTS } from '~/data/airports'\n\nconst topAirports = computed(() => {\n  return [\n    {\n      ...AIRPORTS[0],\n      tag: '原生IP · 长期自用',\n      positioning: '原生住宅IP · 中转优化'\n    },\n    {\n      ...AIRPORTS[1],\n      tag: '纯正IPLC · 抗封锁',\n      positioning: '超低延时 (30-50ms) · 抗QoS'\n    },\n    {\n      ...AIRPORTS[2],\n      tag: '一键极速 · 新手款',\n      positioning: '新手友好 · 三网线路调度'\n    },\n    {\n      ...AIRPORTS[3],\n      tag: 'BGP入口 · 低延迟',\n      positioning: 'BGP智能隧道 · 网页秒开'\n    }\n  ]\n})\n</script>\n","<template>\n  <div class=\"inline-flex items-center gap-2 p-1 bg-[#F2EAE1] rounded-custom border border-[#E4D8C7] text-xs\">\n    <button\n      @click=\"toggleMode\"\n      class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-custom transition-all font-medium text-[#493A30] hover:text-[#79553D]\"\n      :class=\"isDetailed ? 'bg-[#FFFCF5] shadow-sm text-[#79553D] font-bold' : ''\"\n      aria-label=\"切换阅读模式\"\n    >\n      <!-- Animation 6: 按钮图标旋转90度 -->\n      <svg\n        width=\"14\"\n        height=\"14\"\n        class=\"reading-toggle-icon w-3.5 h-3.5 text-[#B08758]\"\n        :class=\"{ active: isDetailed }\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        viewBox=\"0 0 24 24\"\n      >\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M9 5l7 7-7 7\" />\n      </svg>\n      <span>{{ isDetailed ? '详细说明模式' : '简要步骤模式' }}</span>\n    </button>\n    <span class=\"text-[10px] text-[#79553D]/70 px-1 hidden sm:inline\">\n      {{ isDetailed ? '已展开原理解释与参数细节' : '仅看核心关键指令' }}\n    </span>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nconst props = defineProps<{\n  modelValue: boolean\n}>()\n\nconst emit = defineEmits(['update:modelValue'])\n\nconst isDetailed = computed({\n  get: () => props.modelValue,\n  set: (val: boolean) => emit('update:modelValue', val)\n})\n\nconst toggleMode = () => {\n  isDetailed.value = !isDetailed.value\n}\n</script>\n","<template>\n  <div>\n    <!-- 1. Hero Banner with Animation 1 (Bracket open) & High CTR keywords -->\n    <HeroBanner />\n\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-16\">\n      <!-- 2. 重点图解教程 (Featured Illustrated Tutorials) - with Animation 4 (Cover caption expand) -->\n      <section class=\"space-y-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#E4D8C7] pb-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-1.5 text-xs font-bold text-[#B08758] mb-1\">\n              <span>🌟 FEATURED GUIDES</span>\n              <span>·</span>\n              <span>核心推荐</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#493A30] tracking-tight\">\n              重点图解教程：生命周期核心指南\n            </h2>\n          </div>\n          <p class=\"text-xs text-[#79553D]\">\n            从下载安装、订阅更新到异常排查的 4 大核心任务\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          <CoverCard\n            title=\"Clash应用教程：第一次运行到正常退出\"\n            summary=\"从零演示安装授权、节点载入、开启系统代理以及用完后干净退出的完整闭环，避免断网残留。\"\n            link=\"/first-run\"\n            category=\"新手入门\"\n            readTime=\"7分钟\"\n            icon=\"🚀\"\n            badge=\"首推必读\"\n          />\n          <CoverCard\n            title=\"Clash下载：按系统与架构找安装包\"\n            summary=\"精确对照 Windows、macOS (Intel/M系列)、Android 与 iOS 的安装包架构及 Hash 校验，杜绝木马捆绑。\"\n            link=\"/download\"\n            category=\"下载指南\"\n            readTime=\"5分钟\"\n            icon=\"📥\"\n            badge=\"官方原版\"\n          />\n          <CoverCard\n            title=\"Clash订阅管理：跨设备添加与刷新\"\n            summary=\"安全导入机场 YAML 订阅、定时自动更新策略、防 Token 泄露以及节点无法加载的快速抢修技巧。\"\n            link=\"/subscriptions\"\n            category=\"配置管理\"\n            readTime=\"5分钟\"\n            icon=\"🔗\"\n            badge=\"高频实用\"\n          />\n          <CoverCard\n            title=\"Clash无法连接：从核心到日志排查\"\n            summary=\"全面解决“系统代理开了网页打不开”、“节点全红”、“核心端口被占用”等高频症状，附脱敏日志反馈。\"\n            link=\"/app-errors\"\n            category=\"故障排除\"\n            readTime=\"8分钟\"\n            icon=\"🛠️\"\n            badge=\"急救手册\"\n          />\n        </div>\n      </section>\n\n      <!-- 3. 工具分类 (Tool Categories) - with Animation 5 (Tool icon swing) -->\n      <section class=\"space-y-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#E4D8C7] pb-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-1.5 text-xs font-bold text-[#B08758] mb-1\">\n              <span>🗂️ CATEGORIES</span>\n              <span>·</span>\n              <span>知识体系</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#493A30] tracking-tight\">\n              工具分类：全方位覆盖 Clash 知识\n            </h2>\n          </div>\n          <p class=\"text-xs text-[#79553D]\">\n            悬停图标可预览微动效，点击直达各专题深度分类\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n          <ToolCategoryCard\n            title=\"客户端与下载\"\n            desc=\"涵盖 Windows、macOS、Android、iOS 和 Linux 全平台安装包架构与生命周期。\"\n            link=\"/download\"\n            icon=\"💻\"\n            :count=\"6\"\n            tag=\"多端适配\"\n          />\n          <ToolCategoryCard\n            title=\"入门与新手概念\"\n            desc=\"从首次启动到理解核心架构，厘清客户端软件与代理服务的根本区别。\"\n            link=\"/network-intro\"\n            icon=\"🌱\"\n            :count=\"5\"\n            tag=\"零门槛\"\n          />\n          <ToolCategoryCard\n            title=\"配置与订阅管理\"\n            desc=\"掌握 YAML 配置文件、节点测速、分流规则设置及跨设备订阅自动同步。\"\n            link=\"/profiles\"\n            icon=\"⚙️\"\n            :count=\"5\"\n            tag=\"规则分流\"\n          />\n          <ToolCategoryCard\n            title=\"网络与问题诊断\"\n            desc=\"TUN 虚拟网卡、DNS 防污染、关机系统代理残留修复以及全套故障急救方案。\"\n            link=\"/app-errors\"\n            icon=\"🩺\"\n            :count=\"5\"\n            tag=\"急救速查\"\n          />\n          <ToolCategoryCard\n            title=\"2026好用机场推荐\"\n            desc=\"严格收录 28 家真实机场服务商，重磅区分推荐 4 大主力，全网最全独家优惠码。\"\n            link=\"/airport-recommend\"\n            icon=\"✈️\"\n            :count=\"28\"\n            tag=\"4大主力\"\n          />\n          <ToolCategoryCard\n            title=\"常见问答与站点说明\"\n            desc=\"全量默认展开问答，披露真实运营身份，绝不冒充官方或篡改开源二进制。\"\n            link=\"/faq\"\n            icon=\"🛡️\"\n            :count=\"4\"\n            tag=\"全展开FAQ\"\n          />\n        </div>\n      </section>\n\n      <!-- 4. 四大主力机场深度对比与推荐 (Distinguished 4 Main Airports) -->\n      <section>\n        <TopAirportsHero />\n      </section>\n\n      <!-- 5. 核心图解与动画演示区域 (Animations 2, 3, 6, 7, 8, 9, 10 showcase) -->\n      <section class=\"space-y-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#E4D8C7] pb-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-1.5 text-xs font-bold text-[#B08758] mb-1\">\n              <span>🎨 INTERACTIVE DEMO</span>\n              <span>·</span>\n              <span>动效图解课堂</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#493A30] tracking-tight\">\n              最新图解：Clash Verge Rev 核心配置流程\n            </h2>\n          </div>\n          <!-- Reading Mode Switcher (Animation 6: 90 deg rotation) -->\n          <ReadingModeToggle v-model=\"isDetailMode\" />\n        </div>\n\n        <!-- Animation 2, 3, 7, 10 Diagram Viewer -->\n        <DiagramViewer\n          title=\"Clash Verge Rev 标准三步导入与启用流程（点击放大支持水平滑动切图）\"\n          appState=\"已连接 - 香港 01 [IPLC专线]\"\n          calloutHint=\"策略组：PROXIES 自动优选低延迟节点\"\n          :steps=\"[\n            { num: 1, title: '导入机场订阅链接', desc: '复制机场提供的 Clash YAML 订阅 URL，粘贴进订阅框并点击「Save」，客户端将自动拉取全部节点。' },\n            { num: 2, title: '选择目标节点或策略组', desc: '在「代理」界面展开 PROXIES 分组，建议选用自动测速低延迟节点或手动指定原生住宅 IP。' },\n            { num: 3, title: '开启系统代理 / TUN模式', desc: '在右下角或侧边栏点击开启「System Proxy」。若需要接管不支持系统代理的软件，启动「TUN Mode」。' }\n          ]\"\n        />\n\n        <!-- Conditional Detail Expansion based on isDetailMode (Animation 6) -->\n        <Transition\n          enter-active-class=\"transition duration-300 ease-out\"\n          enter-from-class=\"transform -translate-y-2 opacity-0\"\n          enter-to-class=\"transform translate-y-0 opacity-100\"\n          leave-active-class=\"transition duration-200 ease-in\"\n          leave-from-class=\"transform translate-y-0 opacity-100\"\n          leave-to-class=\"transform -translate-y-2 opacity-0\"\n        >\n          <div v-if=\"isDetailMode\" class=\"p-5 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 space-y-3 text-xs leading-relaxed\">\n            <div class=\"flex items-center gap-2 font-bold text-[#79553D]\">\n              <span>💡 详细说明模式已激活：底层原理扩展</span>\n            </div>\n            <p>\n              当开启系统代理（System Proxy）时，Clash 在本地 127.0.0.1 监听 7890 端口，并修改操作系统注册表（Windows）或网络偏好设置（macOS），将 HTTP/HTTPS/SOCKS5 流量重定向至此。若应用不遵循系统代理设置，必须借助 TUN 模式安装虚拟网卡，从网络驱动层拦截所有 IP 数据包。\n            </p>\n          </div>\n        </Transition>\n\n        <!-- Checklist Demo (Animation 8) & Tip Note (Animation 9) -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 items-start\">\n          <Checklist\n            title=\"首次使用 Clash 前置检查清单（主动勾选触发）\"\n            :items=\"[\n              { text: '电脑/手机系统时间已精准同步（误差不能超过 60 秒，否则 TLS 证书握手失败）', tip: '可在系统设置中开启自动与网络授时服务器同步' },\n              { text: '已获取有效的机场订阅链接（推荐使用 U1S1 或 极连云专线订阅）', tip: '订阅链接中包含个人 Token，切勿分享给他人' },\n              { text: '卸载或退出了冲突的第三方 VPN/代理软件', tip: '同时运行多个代理工具会导致虚拟网卡或端口 7890 冲突' },\n              { text: '确认浏览器未安装强制走 Direct 的异常插件', tip: '如 SwitchyOmega 若设置为直接连接会导致网页无法翻墙' }\n            ]\"\n          />\n\n          <div class=\"space-y-4\">\n            <TipNote title=\"避坑便签：关机前为什么必须手动关闭系统代理？\">\n              <p>\n                如果在关机或重启前直接强制拔掉电源、或者 Clash 异常闪退，操作系统中的代理开关未能被正常撤销，仍指向 <code class=\"bg-[#F2EAE1] px-1 rounded\">127.0.0.1:7890</code>。下次开机时因为 Clash 尚未启动，会导致微信、百度等所有国内网站全部打不开。\n              </p>\n              <p class=\"font-bold text-[#79553D] pt-1\">\n                救援方案：进入 Windows 设置 → 网络和 Internet → 代理 → 将「使用代理服务器」手动关闭即可立即恢复！\n              </p>\n            </TipNote>\n\n            <TipNote title=\"核心理念：应用（车）与节点（油）的本质关系\">\n              <p>\n                Clash 本身只是一款开源或社区维护的高性能网络分流客户端（就像一辆性能强劲的跑车）；而机场提供的订阅节点则是燃料（汽油）。跑车必须加满优质汽油才能跑出 4K/8K 的高速体验。\n              </p>\n            </TipNote>\n          </div>\n        </div>\n      </section>\n\n      <!-- 6. 系列学习 (Series Learning Tracks) -->\n      <section class=\"space-y-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#E4D8C7] pb-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-1.5 text-xs font-bold text-[#B08758] mb-1\">\n              <span>📚 SERIES LEARNING</span>\n              <span>·</span>\n              <span>进阶进阶路径</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#493A30] tracking-tight\">\n              系列学习路线：从入门到高阶专家\n            </h2>\n          </div>\n          <p class=\"text-xs text-[#79553D]\">\n            循序渐进的系统化阅读指引\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <!-- Track 1 -->\n          <div class=\"p-6 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] shadow-sm flex flex-col justify-between\">\n            <div class=\"space-y-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded-full bg-[#EBDCCB] text-[#79553D]\">第一阶段 · 搭建基础</span>\n              <h3 class=\"text-lg font-bold text-[#493A30]\">新手起步与多端安装</h3>\n              <p class=\"text-xs text-[#79553D] leading-relaxed\">\n                建立对科学上网基础概念的认识，按自己的设备下载匹配安装包，顺利完成首次翻墙连接。\n              </p>\n              <ul class=\"text-xs space-y-1.5 text-[#493A30] pt-2\">\n                <li><NuxtLink to=\"/network-intro\" class=\"hover:text-[#79553D]\">• 科学上网应用入门：软件安装后还需要什么</NuxtLink></li>\n                <li><NuxtLink to=\"/download\" class=\"hover:text-[#79553D]\">• 按系统和架构下载对应安装包</NuxtLink></li>\n                <li><NuxtLink to=\"/first-run\" class=\"hover:text-[#79553D]\">• 第一次运行到正常退出标准图解</NuxtLink></li>\n              </ul>\n            </div>\n            <div class=\"pt-4 mt-4 border-t border-[#E4D8C7]/50\">\n              <NuxtLink to=\"/first-run\" class=\"text-xs font-bold text-[#79553D] hover:underline flex items-center justify-between\">\n                <span>开始学习入门阶段</span>\n                <span>→</span>\n              </NuxtLink>\n            </div>\n          </div>\n\n          <!-- Track 2 -->\n          <div class=\"p-6 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] shadow-sm flex flex-col justify-between\">\n            <div class=\"space-y-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded-full bg-[#EBDCCB] text-[#79553D]\">第二阶段 · 规则掌握</span>\n              <h3 class=\"text-lg font-bold text-[#493A30]\">分流规则与订阅维护</h3>\n              <p class=\"text-xs text-[#79553D] leading-relaxed\">\n                学会区分 Rule 分流、Direct 直连和 Global 全局模式，管理多套配置文件与订阅自动更新。\n              </p>\n              <ul class=\"text-xs space-y-1.5 text-[#493A30] pt-2\">\n                <li><NuxtLink to=\"/profiles\" class=\"hover:text-[#79553D]\">• Clash 配置管理：导入、保存与迁移</NuxtLink></li>\n                <li><NuxtLink to=\"/subscriptions\" class=\"hover:text-[#79553D]\">• 跨设备添加订阅与防泄露处理</NuxtLink></li>\n                <li><NuxtLink to=\"/routing\" class=\"hover:text-[#79553D]\">• 界面规则设置选项底层对应什么</NuxtLink></li>\n              </ul>\n            </div>\n            <div class=\"pt-4 mt-4 border-t border-[#E4D8C7]/50\">\n              <NuxtLink to=\"/routing\" class=\"text-xs font-bold text-[#79553D] hover:underline flex items-center justify-between\">\n                <span>进入规则配置学习</span>\n                <span>→</span>\n              </NuxtLink>\n            </div>\n          </div>\n\n          <!-- Track 3 -->\n          <div class=\"p-6 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] shadow-sm flex flex-col justify-between\">\n            <div class=\"space-y-3\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded-full bg-[#EBDCCB] text-[#79553D]\">第三阶段 · 高级网络</span>\n              <h3 class=\"text-lg font-bold text-[#493A30]\">TUN模式与故障排查</h3>\n              <p class=\"text-xs text-[#79553D] leading-relaxed\">\n                深入掌握 Fake-IP 与 DNS 防污染解析，配置 TUN 虚拟网卡接管游戏与开发环境，化解各类断网疑难。\n              </p>\n              <ul class=\"text-xs space-y-1.5 text-[#493A30] pt-2\">\n                <li><NuxtLink to=\"/tun-mode\" class=\"hover:text-[#79553D]\">• TUN 模式安装组件与系统权限核对</NuxtLink></li>\n                <li><NuxtLink to=\"/dns-settings\" class=\"hover:text-[#79553D]\">• DNS 覆写设置与防泄露解析管理</NuxtLink></li>\n                <li><NuxtLink to=\"/app-errors\" class=\"hover:text-[#79553D]\">• 无法连接：从核心状态到运行日志</NuxtLink></li>\n              </ul>\n            </div>\n            <div class=\"pt-4 mt-4 border-t border-[#E4D8C7]/50\">\n              <NuxtLink to=\"/app-errors\" class=\"text-xs font-bold text-[#79553D] hover:underline flex items-center justify-between\">\n                <span>查阅高级故障排查</span>\n                <span>→</span>\n              </NuxtLink>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- 7. 全量默认展开 FAQ Section (Requirement: \"所有的FAQ全部要展开\") -->\n      <section class=\"space-y-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#E4D8C7] pb-4\">\n          <div>\n            <div class=\"inline-flex items-center gap-1.5 text-xs font-bold text-[#B08758] mb-1\">\n              <span>❓ FAQ</span>\n              <span>·</span>\n              <span>全部展开问答</span>\n            </div>\n            <h2 class=\"text-2xl sm:text-3xl font-extrabold text-[#493A30] tracking-tight\">\n              新手常见疑问：默认全部展开解答\n            </h2>\n          </div>\n          <p class=\"text-xs text-[#79553D]\">\n            直观展现核心知识点，无需折叠与点击\n          </p>\n        </div>\n\n        <FaqList />\n      </section>\n\n      <!-- 8. 作者与本站介绍 (Author Introduction & Identity) -->\n      <section class=\"p-6 sm:p-8 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] shadow-sm flex flex-col md:flex-row items-center gap-6\">\n        <div class=\"w-20 h-20 rounded-custom bg-[#79553D] flex items-center justify-center p-3 border-2 border-[#B08758] shrink-0 shadow-md\">\n          <img src=\"/logo.png\" alt=\"clash-app.blog logo\" class=\"w-full h-full object-contain\" />\n        </div>\n        <div class=\"space-y-2 text-center md:text-left flex-1\">\n          <div class=\"flex flex-wrap items-center justify-center md:justify-start gap-2\">\n            <h3 class=\"text-xl font-extrabold text-[#493A30]\">关于 clashapp·图解课堂</h3>\n            <span class=\"text-xs px-2 py-0.5 rounded bg-[#EBDCCB] text-[#79553D] font-mono\">clash-app.blog</span>\n          </div>\n          <p class=\"text-xs sm:text-sm text-[#79553D] leading-relaxed\">\n            本站由一群资深网络协议研究者与前端工程师共同编撰。我们坚持“图解优先、真实证据交付、客观中立测评”的原则，所有安装包均核对官方发布源与哈希值。对于第三方推荐链接，严格执行 <code class=\"bg-[#F2EAE1] px-1 rounded text-[#79553D]\">rel=\"sponsored nofollow noopener\"</code> 标准，确保透明公开，杜绝黑心带货与虚标骗局。\n          </p>\n          <div class=\"pt-2 flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs font-medium text-[#79553D]\">\n            <NuxtLink to=\"/about\" class=\"hover:underline text-[#493A30] font-bold\">了解完整站点说明与商业关系 →</NuxtLink>\n            <NuxtLink to=\"/about#contact\" class=\"hover:underline\">提交教程纠错与意见反馈</NuxtLink>\n            <NuxtLink to=\"/about#privacy\" class=\"hover:underline\">隐私与数据声明</NuxtLink>\n          </div>\n        </div>\n      </section>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref } from 'vue'\n\nuseHead({\n  title: 'clashapp：按平台选择Clash应用并学会维护｜clashapp',\n  meta: [\n    { name: 'description', content: '围绕选择操作系统、确认应用与安装包、从首次运行到维护，按具体项目、系统与版本提供图解教程、操作实例和验证方法。' },\n    { name: 'keywords', content: 'clashapp, Clash知识, Clash教程, 科学上网, Clash下载, Clash配置, Clash机场推荐, 高性价比梯子, 2026稳定机场' }\n  ],\n  link: [\n    { rel: 'canonical', href: 'https://clash-app.blog/' }\n  ]\n})\n\nconst isDetailMode = ref(false)\n</script>\n"],"version":3}