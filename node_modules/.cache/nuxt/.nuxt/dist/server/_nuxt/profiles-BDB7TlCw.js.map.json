{"file":"profiles-BDB7TlCw.js","mappings":";;;;;;;;;;;;EAmEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,WAAW;EAEvD,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GAjHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA4DgB,GAAA,OAAA,SAAA,aAAA;;;;OAjCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,yBAAwB,GAAA;OAAvC,SAAAG,SAEU,GAAA,OAAA,SAAA,aAAA;;a,QADRC,YAAsI,KAAA,MAAnI,iIAA+H,C;;;;;;OAUlI,OAAM;OACL,OAAO;;;;MArDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAmC,UAAA,MAA3B,oBAAkB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WAC7K;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,cAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,kJAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,aAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAA;QAACC,gBAAA,6DACD;QAAAD,YAA2C,QAAA,MAArC,kCAA8B;QAAOC,gBAAA,aAAW;QAAAD,YAA+D,QAAA,MAAzD,oDAAkD;QAAOC,gBAAA,sDACjL;;OAGAD,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,YAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,sJAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,yBAAwB,GAAA;QACrC,SAAAD,cAAsI,CAAtIC,YAAsI,KAAA,MAAnI,iIAA+H,C;;;;MAKtIA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/profiles.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash配置管理：导入、保存与迁移</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 配置存放与选择\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        Clash 客户端的核心运行依赖于 YAML 格式的配置文件。配置文件不仅包含了你的节点服务器连接凭据（密码、端口、UUID、公钥），还规定了 DNS 解析逻辑、本地监听端口、TUN 虚拟网卡参数以及流量分流策略组。理解配置文件的存放路径与层次结构，是跨设备迁移与灾难备份的核心技能。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 备份有效内容\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        在桌面客户端（如 Clash Verge Rev）中，配置文件通常存放在应用的数据目录中（例如 Windows 的 <code>%APPDATA%\\clash-verge\\profiles</code> 或 macOS 的 <code>~/Library/Application Support/clash-verge/profiles</code>）。订阅导入时，客户端会自动将远程 YAML 保存为独立哈希命名的文件，避免直接修改内核的主运行模板。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"Clash 配置存储体系与多配置切换结构图\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"本地 profiles 目录与运行时合并配置关系\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 迁移后核对\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        进行配置备份时，切勿直接将包含私人订阅 Token 的完整文件公开上传至公共 GitHub 仓库或分享给他人。推荐定期压缩 profiles 目录并进行本地离线归档；在迁移至新电脑或新设备时，只需在目标设备上重新导入订阅 URL，或者解压本地备份覆盖即可瞬间还原所有的分流规则和节点选择偏好。\n      </p>\n\n      <TipNote title=\"避坑提示：换新客户端后原有规则报错怎么处理？\">\n        <p>部分老旧配置使用了已弃用的旧版 Clash 语法（如旧版 proxy-groups 格式）。若在新版 Clash Verge（Mihomo内核）中运行报错，只需右键订阅卡片执行一次「更新订阅」，机场服务端会自动下发兼容最新 Mihomo 内核的规范配置。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash配置管理：导入、保存与迁移 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/profiles')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"识别本地 profiles 存储目录\",\n    \"desc\": \"在客户端配置界面右键点击订阅卡片，选择「打开所在文件夹」，直接定位实际 YAML 文件存放路径。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"提取并备份有效分流规则\",\n    \"desc\": \"若自己编写了自定义扩展脚本（Script）或覆写规则（Merge），单独备份该 yaml 文本文件。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"迁移后进行语法与核心校验\",\n    \"desc\": \"将配置导入新设备后，观察右上角是否提示 YAML 语法解析成功，核对节点数与策略组完整度。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"已明确本地 profiles 真实物理存放路径，未直接篡改程序安装包目录\",\n    \"tip\": \"安装目录与用户数据目录是分离的\"\n  },\n  {\n    \"text\": \"定期将个性化分流规则和扩展配置脚本进行本地文本备份\",\n    \"tip\": \"防范客户端升级意外覆盖用户设置\"\n  },\n  {\n    \"text\": \"跨设备迁移时优先复制机场订阅链接重新下载最新节点池\",\n    \"tip\": \"推荐搭配 U1S1 或 极连云 专线订阅保持节点最新\"\n  },\n  {\n    \"text\": \"确认新设备上无端口冲突（如 7890 端口未被其他服务抢占）\",\n    \"tip\": \"若冲突可在设置中修改监听端口\"\n  }\n]\n</script>\n"],"version":3}