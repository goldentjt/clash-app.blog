{"file":"meta-core-1pW6xwx7.js","mappings":";;;;;;;;;;;;EAmEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,YAAY;EAExD,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GAjHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA4DgB,GAAA,OAAA,SAAA,aAAA;;;;OAjCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,oBAAmB,GAAA;OAAlC,SAAAG,SAEU,GAAA,OAAA,SAAA,aAAA;;a,QADRC,YAAoH,KAAA,MAAjH,+GAA6G,C;;;;;;OAUhH,OAAM;OACL,OAAO;;;;MArDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAuC,UAAA,MAA/B,wBAAsB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WACjL;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,aAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,uJAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,eAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,iQAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,cAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,2JAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,oBAAmB,GAAA;QAChC,SAAAD,cAAoH,CAApHC,YAAoH,KAAA,MAAjH,+GAA6G,C;;;;MAKpHA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/meta-core.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash Meta与应用：怎样核对内置核心</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 查客户端记录\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        许多读者在选购机场套餐时，经常会看到某些机场标注“要求必须使用 Meta 内核或 Clash Verge 才能连接”。这让很多初学者感到困惑：我用的就是 Clash，为什么连不上？核心原因就在于：**Clash 客户端只是外壳，内部真正执行网络加密与数据传输的是其底层的 Core（内核）**。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 确认实际核心版本\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        传统的开源 Clash Premium 内核停更较早，仅支持 Shadowsocks、Vmess、Trojan 等老旧协议；而 **Clash.Meta（现更名为 Mihomo）** 则是目前最强大的现代化开源内核，引入了对 **VLESS（含 Reality 伪装与 XTLS Vision）**、**Hysteria2**、**TUIC v5**、**WireGuard** 以及 GeoSite/GeoIP 规则集的全面支持。因此，现代机场提供的前沿抗封锁专线，必须依赖 Meta 核心才能识别驱动。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"GUI 外壳与内置 Mihomo (Meta) 内核协作架构图\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"前端界面向后端核心发送指令与拉取运行日志\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 核对格式和能力\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        在 Clash Verge Rev 中，可轻松核对当前使用的核心：进入「设置」→「Clash 内核」，界面会明确列出当前核心类型（通常默认为 Clash Meta 或 Mihomo）及其编译版本号（如 v1.18.7）。客户端还支持在 Alpha 测试版内核与 Release 稳定版内核之间一键切换。\n      </p>\n\n      <TipNote title=\"核心升级后为什么有时候会启动失败？\">\n        <p>Mihomo 在大版本更迭时，偶尔会废弃个别过时的 YAML 实验性配置参数。如果切换到 Alpha 内核后提示 Core Crash，只需在设置中将内核切回 Release 稳定版，或者更新一次机场订阅即可瞬间恢复。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash Meta与应用：怎样核对内置核心 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/meta-core')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"在客户端设置中定位 Clash 内核模块\",\n    \"desc\": \"进入 Clash Verge 的设置菜单，找到「Clash 内核 / Core」区域查看当前引擎。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"确认当前核心为 Clash Meta / Mihomo\",\n    \"desc\": \"若使用的是其他老旧内核，点击切换为 Meta 内核以解锁全部现代协议支持。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"核对版本支持的能力范围与配置规范\",\n    \"desc\": \"确认当前版本支持你所选机场的 VLESS/Reality 配置，避免语法不识别报错。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"客户端内置核心已切换为 Clash Meta / Mihomo 最新稳定版本\",\n    \"tip\": \"确保能完美解析所有机场的新型协议节点\"\n  },\n  {\n    \"text\": \"在节点列表中能正常看到 vless:// 或 reality 类型的节点不报错\",\n    \"tip\": \"老旧核心会提示 unknown proxy type\"\n  },\n  {\n    \"text\": \"了解 Meta 内核对 GeoData / Rule-Set 规则集的强大支持\",\n    \"tip\": \"分流更精准，内存占用更小\"\n  },\n  {\n    \"text\": \"搭配优质专线服务商（如 极连云、U1S1、唯兔云）充分释放新协议威力\",\n    \"tip\": \"前往推荐页获取专属体验\"\n  }\n]\n</script>\n"],"version":3}