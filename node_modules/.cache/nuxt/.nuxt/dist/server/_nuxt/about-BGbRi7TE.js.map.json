{"file":"about-BGbRi7TE.js","mappings":";;;;;;;;;;;;EAmEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,QAAQ;EAEpD,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GAjHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA4DgB,GAAA,OAAA,SAAA,aAAA;;;;OAjCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,YAAW,GAAA;OAA1B,SAAAG,SAEU,GAAA,OAAA,SAAA,aAAA;;a,QADRC,YAA8E,KAAA,MAA3E,yEAAuE,C;;;;;;OAU1E,OAAM;OACL,OAAO;;;;MArDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAwC,UAAA,MAAhC,yBAAuB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WAClL;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,gBAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,mJAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,WAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,4IAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,cAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,yMAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,YAAW,GAAA;QACxB,SAAAD,cAA8E,CAA9EC,YAA8E,KAAA,MAA3E,yEAAuE,C;;;;MAK9EA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/about.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>关于clashapp：下载资料、教程和更新维护</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 登记与核验下载资料\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        欢迎访问 clashapp·图解课堂（唯一官方访问域名：https://clash-app.blog）。本站致力于构建一个客观、专业、不弄虚作假的中文 Clash 知识图谱。我们围绕应用从获取、安装、首次运行到迁移、更新和卸载的完整生命周期组织内容，提供高质量的图解与可复现的操作步骤。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 联系纠错\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        【登记与核验下载资料】本站不是任何开源项目的官方开发者或核心维护团队，我们绝不将本站名义冒充为官方身份。本站展示的所有客户端版本信息、架构说明与 Hash 校验值均忠实取自开源上游仓库。未经验证的第三方链接均明确保持「下载地址待提供」状态，正文与教程依然保持完整独立可读。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"clashapp·图解课堂 运营与技术中立性架构图\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"知识优先、真实核验与透明商业合作标准\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 隐私和商业关系\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        【隐私与商业关系披露】本站严格尊重每一位访客的隐私，不收集任何用户私人网络日志，不安装任何侵入式追踪脚本。本站的机场推荐属于公开的商业服务入口，我们坚持实测实录，所有跳转至第三方机场网站的推广与邀请链接，均一律明确标记 `rel=\"sponsored nofollow noopener\"` 与 `target=\"_blank\"`，既保障本站权重的纯净，也充分保障读者的知情权与选择权。\n      </p>\n\n      <TipNote title=\"联系与勘误渠道说明\">\n        <p>如果您在阅读过程中发现某项技术参数发生变化，或某个客户端新版调整了界面布局，欢迎发送邮件至反馈邮箱进行指正。我们将在核验后第一时间更新知识库。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"关于clashapp：下载资料、教程和更新维护 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/about')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"真实客观的内容编撰体系\",\n    \"desc\": \"所有图解步骤均在真实 Windows、Mac、Android 设备上测试截图并制作标注。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"透明规范的第三方合作\",\n    \"desc\": \"合作机场必须具备真实专线、稳定技术团队与良好口碑，杜绝跑路跑包黑心平台。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"开放的社区勘误与反馈渠道\",\n    \"desc\": \"设立清晰的反馈渠道，欢迎各界开发者与用户对陈旧知识点提出修改指正。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"认准官方唯一访问域名：https://clash-app.blog\",\n    \"tip\": \"防范假冒克隆与钓鱼站点\"\n  },\n  {\n    \"text\": \"理解本站的技术传播者定位，不冒充开源项目开发者\",\n    \"tip\": \"致敬开源社区与内核开发者\"\n  },\n  {\n    \"text\": \"理解推荐链接挂载的 rel=\\\"sponsored nofollow noopener\\\" 属性\",\n    \"tip\": \"符合 Google 搜索规范与网络伦理\"\n  },\n  {\n    \"text\": \"遇到失效教程可随时向站长邮箱发送反馈建议\",\n    \"tip\": \"保持教程版本与时俱进\"\n  }\n]\n</script>\n"],"version":3}