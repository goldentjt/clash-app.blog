{"file":"projects-e_i7Nq9p.js","mappings":";;;;;;;;;;;;EAmEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,WAAW;EAEvD,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GAjHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA4DgB,GAAA,OAAA,SAAA,aAAA;;;;OAjCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,mBAAkB,GAAA;OAAjC,SAAAG,SAEU,GAAA,OAAA,SAAA,aAAA;;a,QADRC,YAAgH,KAAA,MAA7G,2GAAyG,C;;;;;;OAU5G,OAAM;OACL,OAAO;;;;MArDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAmC,UAAA,MAA3B,oBAAkB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WAC7K;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,aAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,kKAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,iBAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,kNAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,gBAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,yHAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,mBAAkB,GAAA;QAC/B,SAAAD,cAAgH,CAAhHC,YAAgH,KAAA,MAA7G,2GAAyG,C;;;;MAKhHA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/projects.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash官网项目：从项目到分发资料</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 核对具体应用\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        在中文搜索引擎中检索“Clash 官网”，会出现大量充斥着高仿 UI、虚假客服甚至捆绑后门病毒的所谓“官网”。要建立正确的防骗意识，首先必须理解：**原版 Clash 核心早于 2023 年底停止维护，目前活跃且被广泛使用的均为开源社区分支或衍生项目**。不存在任何一个自称代表所有 Clash 官方的商业公司网站。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 记录维护方与发布来源\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        目前最为主流、受到全球开发者广泛认可的核心是 **Mihomo（前身为 Clash.Meta）**，由 MetaCubeX 开源组织在 GitHub 上公开维护；而主流的桌面端应用程序则是 **Clash Verge Rev**，由社区团队基于 Tauri 框架重构维护；安卓端主流为 **Clash Meta for Android**。所有的正规发布版本均以 GitHub Releases 为唯一权威源头。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"Clash 开源衍生谱系与真实来源溯源图解\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"原版核心停更后的开源分支生态树\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 标明镜像和分发身份\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        本站建立此项目索引，旨在清晰记录各项目的真实维护组织、代码仓库出处以及版本演进历史，帮助读者学会通过查看 GitHub 仓库 Star 数、Release 发布签名以及 Commits 提交记录来辨识正版正规项目，杜绝误入钓鱼木马站。\n      </p>\n\n      <TipNote title=\"为什么搜索引擎前几个都是假官网？\">\n        <p>部分不良黑产团队利用 SEO 黑帽技术与竞价排名，买下了带有 clash 关键词的域名，并在其中捆绑盗版机场或流氓推广软件。只要认准本站整理的项目登记表与 GitHub 官方源头，即可彻底免疫所有李鬼钓鱼站点！</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash官网项目：从项目到分发资料 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/projects')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"认准权威开源维护组织 GitHub 仓库\",\n    \"desc\": \"核心认准 MetaCubeX/mihomo，桌面客户端认准 clash-verge-rev/clash-verge-rev。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"识别仿冒假官网的典型套路\",\n    \"desc\": \"警惕页面上只有收费购买套餐按钮、没有任何代码仓库链接的假冒下载站。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"查验安装包代码签名与 Hash 校验码\",\n    \"desc\": \"下载后比对 Release 页面公布的 sha256 字符串，确保安装包未被中间人篡改。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"已明确认知不存在所谓的「Clash 官方商业独家官网」\",\n    \"tip\": \"破除假官网营销洗脑套路\"\n  },\n  {\n    \"text\": \"能通过 GitHub Release 直接查看软件的原作者提交记录与发布包\",\n    \"tip\": \"掌握自主获取正版开源软件的能力\"\n  },\n  {\n    \"text\": \"认准主流内核为 Mihomo (Meta) 并理解其继承与突破\",\n    \"tip\": \"支持 VLESS、Hysteria2 等全新现代协议\"\n  },\n  {\n    \"text\": \"对任何来路不明的 .exe/.apk 保持警惕，必经杀毒引擎扫描\",\n    \"tip\": \"保障个人终端数据资产安全\"\n  }\n]\n</script>\n"],"version":3}