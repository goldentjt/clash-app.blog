4EAA2E,GAAA;SACpFA,YAGM,OAAA,EAHD,OAAM,oCAAmC,GAAA,CAC5CA,YAAyD,UAAA,EAAjD,OAAM,iBAAgB,GAAC,mBAAiB,GAChDA,YAAuF,QAAA,EAAjF,OAAM,gEAA+D,GAAC,MAAI,C;SAElFA,YAA8D,KAAA,EAA3D,OAAM,6BAA4B,GAAC,sBAAoB;SAC1DA,YASM,OAAA,EATD,OAAM,OAAM,GAAA,CACfA,YAOI,KAAA;UANF,MAAK;UACL,QAAO;UACP,KAAI;UACJ,OAAM;SACP,GAAA,oBAED,C;;;;MAORA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,gBAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,8HAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAWU,WAAA;OAXD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,gBAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,iKAE7D;OAEAA,YAEU,oBAAA,EAFD,OAAM,kCAAiC,GAAA;QAC9C,SAAAD,cAAoF,CAApFC,YAAoF,KAAA,MAAjF,+EAA6E,C;;;;MAKpFA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/iphone.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash iPhone应用选择与安装使用指南</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 确认应用和分发渠道与官方下载\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        iOS 生态需使用海外（如美区）Apple ID 前往 App Store 获取兼容 Clash 规则的工具。官方商店正版直达链接（带 <code>rel=\"sponsored nofollow noopener\"</code>）：\n      </p>\n\n      <!-- iOS App Store Grid -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1\">\n        <div class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] space-y-2 text-xs\">\n          <div class=\"flex items-center justify-between\">\n            <strong class=\"text-[#493A30]\">Shadowrocket (小火箭)</strong>\n            <span class=\"text-[10px] px-1.5 py-0.2 rounded bg-[#79553D] text-white\">新手最普及</span>\n          </div>\n          <p class=\"text-[11px] text-[#79553D]\">售价2.99美元，直导Clash YAML订阅，操作极简</p>\n          <div class=\"pt-1\">\n            <a\n              href=\"https://apps.apple.com/us/app/id932747118\"\n              target=\"_blank\"\n              rel=\"sponsored nofollow noopener\"\n              class=\"w-full py-1 rounded bg-[#79553D] text-white text-[11px] font-bold hover:bg-[#5C3E2A] shadow-xs text-center block\"\n            >\n              App Store 官方下载 ↗\n            </a>\n          </div>\n        </div>\n\n        <div class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] space-y-2 text-xs\">\n          <div class=\"flex items-center justify-between\">\n            <strong class=\"text-[#493A30]\">Stash (iOS版Clash)</strong>\n            <span class=\"text-[10px] px-1.5 py-0.2 rounded bg-[#B08758] text-white\">最原生Clash</span>\n          </div>\n          <p class=\"text-[11px] text-[#79553D]\">原生Clash配置规范，可视化分流与按需连接</p>\n          <div class=\"pt-1\">\n            <a\n              href=\"https://apps.apple.com/us/app/id1596063349\"\n              target=\"_blank\"\n              rel=\"sponsored nofollow noopener\"\n              class=\"w-full py-1 rounded bg-[#79553D] text-white text-[11px] font-bold hover:bg-[#5C3E2A] shadow-xs text-center block\"\n            >\n              App Store 官方下载 ↗\n            </a>\n          </div>\n        </div>\n\n        <div class=\"p-3 rounded-custom bg-[#FFFCF5] border border-[#E4D8C7] space-y-2 text-xs\">\n          <div class=\"flex items-center justify-between\">\n            <strong class=\"text-[#493A30]\">Quantumult X (圈叉)</strong>\n            <span class=\"text-[10px] px-1.5 py-0.2 rounded bg-[#EBDCCB] text-[#79553D]\">高阶利器</span>\n          </div>\n          <p class=\"text-[11px] text-[#79553D]\">重度极客首选，支持强大重写与高级策略分流</p>\n          <div class=\"pt-1\">\n            <a\n              href=\"https://apps.apple.com/us/app/id1443988620\"\n              target=\"_blank\"\n              rel=\"sponsored nofollow noopener\"\n              class=\"w-full py-1 rounded bg-[#79553D] text-white text-[11px] font-bold hover:bg-[#5C3E2A] shadow-xs text-center block\"\n            >\n              App Store 官方下载 ↗\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 核对系统与配置支持\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        获取上述软件必须使用**非国区 Apple ID**（如美区、日区、港区 Apple ID）。用户可自行注册一个免信用卡的美区账号，或在正规数字礼品卡平台购买 3 美元充值卡兑换下载。下载完成后即可切回原个人日常账号，软件更新与使用均不受影响。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"iOS 生态客户端获取与 Clash 订阅导入流程图\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"非国区 Apple ID 获取与 Shadowrocket/Stash 规则配置\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 首次连接和数据迁移\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        在 iOS 端导入订阅非常简单：以 Shadowrocket 为例，打开软件点击右上角「+」，类型选择「Subscribe」，粘贴机场订阅 URL 并点击右上角完成，节点瞬间刷出。在下方「全局路由」选择「配置（Config）」，点击连接开关并在系统弹窗中通过面容 ID（Face ID）允许添加 VPN 配置即可！\n      </p>\n\n      <TipNote title=\"iOS 客户端节点更新提示「Invalid URL」怎么解决？\">\n        <p>这是由于部分输入法在复制粘贴时，自动在 URL 尾部添加了不可见的空格或换行符。长按输入框全选并删除，手动仔细粘贴并检查末尾，确保无多余空格即可顺利拉取。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash iPhone应用选择与安装使用指南 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/iphone')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"登录海外 Apple ID 获取客户端\",\n    \"desc\": \"在 App Store 登录非国区账号，搜索获取 Shadowrocket、Stash 或 Karing。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"添加 Subscribe 订阅并拉取节点\",\n    \"desc\": \"新建配置选择 Subscribe 类型，填入机场订阅链接，全量节点列表自动生成。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"全局路由保持「配置」开启连接\",\n    \"desc\": \"全局路由选择「配置」实现国内外自动分流，开启上方开关并验证 Face ID。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"在 App Store 仅切换个人账号用于下载，切勿在系统「iCloud 设置」中登录未知共享账号\",\n    \"tip\": \"防止设备被意外锁死\"\n  },\n  {\n    \"text\": \"全局路由务必保持在「配置（Config）」，而不是「代理（Proxy）」\",\n    \"tip\": \"保证微信、网易云等国内直连走免流\"\n  },\n  {\n    \"text\": \"测试开启 VPN 后后台持续运行良好，无突发闪退\",\n    \"tip\": \"iOS NetworkExtension 机制极度省电稳定\"\n  },\n  {\n    \"text\": \"已在节点列表中选定主力使用的原生或专线节点\",\n    \"tip\": \"搭配本站推荐的 U1S1 或 极连云 体验最佳\"\n  }\n]\n</script>\n"],"version":3}