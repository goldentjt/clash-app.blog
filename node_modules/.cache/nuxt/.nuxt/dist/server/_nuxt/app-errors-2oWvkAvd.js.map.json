{"file":"app-errors-2oWvkAvd.js","mappings":";;;;;;;;;;;;EAsEA,MAAM,WAAW,MAAM,MAAK,MAAK,EAAE,SAAS,aAAa;EAEzD,QAAQ;GACN,OAAO,SAAS;GAChB,MAAM,CACJ;IAAE,MAAM;IAAe,SAAS,SAAS;GAAY,GACrD;IAAE,MAAM;IAAY,SAAS,SAAS,SAAS,KAAK,IAAI;GAAE,CAC5D;GACA,MAAM,CACJ;IAAE,KAAK;IAAa,MAAM,yBAAyB,SAAS;GAAO,CACrE;EACF,CAAC;EAED,MAAM,eAAe;GACnB;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;GACA;IACE,OAAO;IACP,SAAS;IACT,QAAQ;GACV;EACF;EACA,MAAM,iBAAiB;GACrB;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;GACA;IACE,QAAQ;IACR,OAAO;GACT;EACF;;;;;;GApHkB,MAAAA,mBAAA,0BAAAC,WAAA,EAAA,MAAMC,MAAA,QAAA,EAAQ,GAAA,MAAA,GAAA;IAA9B,SAAAC,SA+DgB,GAAA,OAAA,SAAA,aAAA;;;;OApCV,OAAM;OACN,UAAS;OACT,aAAY;OACX,OAAO;;;MAaD,MAAAH,mBAAA,oBAAA,EAAA,OAAM,kBAAiB,GAAA;OAAhC,SAAAG,SAKU,GAAA,OAAA,SAAA,aAAA;;a,QAJRC,YAGiC,KAAA,MAH9B,wIAG0B,C;;;;;;OAU7B,OAAM;OACL,OAAO;;;;MAxDZA,YAEM,OAAA,EAFD,OAAM,oGAAmG,GAAA;OAC5GA,YAA2B,UAAA,MAAnB,YAAU;OAASC,gBAAA,QAAM;OAAAD,YAAuC,UAAA,MAA/B,wBAAsB;OAASC,gBAAA,2DAAyD;OAAAD,YAA8C,QAAA,MAAxC,qCAAiC;OAAOC,gBAAA,WACjL;;MAGAD,YAOU,WAAA;OAPD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,eAExF,GACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,uIAE7D,C;MAIFA,YAeU,WAAA;OAfD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,aAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,mPAE7D;OAGAA,YAKE,0BAAA;QAJA,OAAM;QACN,UAAS;QACT,aAAY;QACX,OAAO;;;MAKZA,YAcU,WAAA;OAdD,IAAG;OAAY,OAAM;;OAC5BA,YAEK,MAAA,EAFD,OAAM,8EAA6E,GAAC,cAExF;OACAA,YAEI,KAAA,EAFD,OAAM,oDAAmD,GAAC,yFAE7D;OAEAA,YAKU,oBAAA,EALD,OAAM,kBAAiB,GAAA;QAC9B,SAAAD,cAGiC,CAHjCC,YAGiC,KAAA,MAH9B,wIAG0B,C;;;;MAKjCA,YAQU,WAAA;OARD,IAAG;OAAY,OAAM;M,IAC5BA,YAEK,MAAA,EAFD,OAAM,kEAAiE,GAAC,eAE5E,GACAA,YAGE,sBAAA;OAFA,OAAM;OACL,OAAO","names":["_ssrRenderComponent","_mergeProps","_unref","_withCtx","_createVNode","_createTextVNode"],"sources":["../../../../../../../pages/app-errors.vue"],"sourcesContent":["<template>\n  <ArticleLayout :page=\"pageMeta\">\n    <!-- Intro Box -->\n    <div class=\"p-4 rounded-custom bg-[#F4ECE1] border border-[#B08758]/50 text-xs text-[#79553D] leading-relaxed\">\n      <strong>核心任务与验证口径：</strong> 本文针对 <strong>Clash应用无法连接：从安装状态到运行记录</strong> 进行全流程图解与实操复盘。正文涵盖具体配置步骤、预期结果判定与异常恢复方案，所有涉及第三方服务的链接均严格添加 <code>rel=\"sponsored nofollow noopener\"</code>，确保合规透明。\n    </div>\n\n    <!-- Section 1 -->\n    <section id=\"section-1\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        1. 确认软件正常运行\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        “Clash 开了但网页打不开”、“软件界面全是红色超时”、“关闭 Clash 后电脑彻底断网无法上网”——这是新手在使用代理工具时遇到最为频繁的三大拦路虎。面对网络故障，切忌慌乱重装系统，按照标准的「自底向上」排查链路，通常 3 分钟内即可精准定位并化解故障。\n      </p>\n    </section>\n\n    <!-- Section 2 -->\n    <section id=\"section-2\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        2. 核对有效配置\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        排查第一步是确认内核与端口状态：进入任务管理器，确认 `mihomo.exe` 或 `clash-meta` 核心进程正在运行，且本地 7890 端口未被其他下载工具或旧代理残余占用；第二步是确认系统代理开关是否生效；第三步是查看日志面板（Logs），如果日志中大量出现 `handshake failed: certificate has expired`，100% 是系统时间未同步；如果出现 `connect: connection refused`，则是节点服务器离线。\n      </p>\n\n      <!-- Embedded Diagram Viewer (Animations 2, 3, 7, 10) -->\n      <DiagramViewer\n        title=\"Clash 无法连接故障排障决策树\"\n        appState=\"已就绪 - 规则配置正常\"\n        calloutHint=\"核心-端口-配置-节点-时间五维诊断链\"\n        :steps=\"diagramSteps\"\n      />\n    </section>\n\n    <!-- Section 3 -->\n    <section id=\"section-3\" class=\"space-y-4\">\n      <h2 class=\"text-xl sm:text-2xl font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        3. 检查节点和目标\n      </h2>\n      <p class=\"text-xs sm:text-sm text-[#493A30] leading-relaxed\">\n        如果是由于关机未正常退出 Clash 导致的断网残疾，核心病因是系统网络设置中的「手动代理服务器」未被自动撤销。只需进入系统设置手动关闭代理即可立刻恢复所有国内网站访问。\n      </p>\n\n      <TipNote title=\"提报故障给客服时的脱敏日志模板\">\n        <p>如需向机场客服或社区提报日志，请先隐藏私密信息：\n1. 隐藏含有 token= 或 password 的私密参数；\n2. 截取最近 10 行带有 [ERROR] 或 [WARN] 的具体信息；\n3. 附带当前客户端版本（如 Verge Rev 1.7.7）与核心版本。</p>\n      </TipNote>\n    </section>\n\n    <!-- Section 4: Checklist (Animation 8) -->\n    <section id=\"section-4\" class=\"space-y-4\">\n      <h3 class=\"text-lg font-bold text-[#493A30] border-b border-[#E4D8C7] pb-2\">\n        本机完成任务后的检查项\n      </h3>\n      <Checklist\n        title=\"Clash应用无法连接：从安装状态到运行记录 - 实施自检清单\"\n        :items=\"checklistItems\"\n      />\n    </section>\n\n    \n  </ArticleLayout>\n</template>\n\n<script setup lang=\"ts\">\nimport { PAGES } from '~/data/pages'\n\nconst pageMeta = PAGES.find(p => p.path === '/app-errors')!\n\nuseHead({\n  title: pageMeta.title,\n  meta: [\n    { name: 'description', content: pageMeta.description },\n    { name: 'keywords', content: pageMeta.keywords.join(', ') }\n  ],\n  link: [\n    { rel: 'canonical', href: `https://clash-app.blog${pageMeta.path}` }\n  ]\n})\n\nconst diagramSteps = [\n  {\n    \"num\": 1,\n    \"title\": \"检查系统时间是否精准同步\",\n    \"desc\": \"打开系统时钟设置执行立即同步，时间误差不能超过 60 秒，化解 90% 的 SSL/TLS 证书握手失败。\"\n  },\n  {\n    \"num\": 2,\n    \"title\": \"检查 7890 端口监听与核心状态\",\n    \"desc\": \"查看右下角状态指示灯是否为绿色，若提示 Port 7890 in use，在设置中将端口改为 7892 等空闲端口。\"\n  },\n  {\n    \"num\": 3,\n    \"title\": \"查看 Logs 日志面板提取真实错误代码\",\n    \"desc\": \"在侧边栏「日志」中筛选 Error 级别日志，观察是 DNS 解析失败、握手错误还是节点已下线。\"\n  }\n]\nconst checklistItems = [\n  {\n    \"text\": \"系统时间已完成互联网校准（可在 time.is 网站快速复核）\",\n    \"tip\": \"最常见却最易被忽视的隐蔽故障原因\"\n  },\n  {\n    \"text\": \"确认 Clash 运行时无第三方杀毒软件进行静默拦截或断网防火墙阻断\",\n    \"tip\": \"临时关闭第三方管家测试\"\n  },\n  {\n    \"text\": \"确认机场套餐有效且流量充沛（可前往推荐页选备用专线）\",\n    \"tip\": \"建议常备如 极连云 或 U1S1 备用节点\"\n  },\n  {\n    \"text\": \"掌握系统代理残留手工撤销方法，能独立恢复本机默认上网状态\",\n    \"tip\": \"Windows设置->网络->代理->关闭代理服务器\"\n  }\n]\n</script>\n"],"version":3}